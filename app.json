{
  "expo": {
    "name": "AviChat",
    "slug": "avichat",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "avichat",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#568203"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.avichat.app",
      "requireFullScreen": false,
      "infoPlist": {
        "NSCameraUsageDescription": "AviChat needs camera access to take photos for custom vocabulary symbols.",
        "NSPhotoLibraryUsageDescription": "AviChat needs photo library access to select images for custom vocabulary symbols."
      }
    },
    "android": {
      "package": "com.avichat.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#568203"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "AviChat needs photo library access to select images for custom vocabulary symbols.",
          "cameraPermission": "AviChat needs camera access to take photos for custom vocabulary symbols."
        }
      ]
    ]
  }
}
